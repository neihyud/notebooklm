{
  "manifest_version": 3,
  "name": "NotebookLM Importer",
  "version": "0.1.0",
  "description": "Trích cục bộ video YouTube và trang tài liệu, rồi đẩy vào Notebook đích.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/common/shared.js",
        "src/common/messages.js",
        "src/youtube/selectors.js",
        "src/youtube/bridge-protocol.js",
        "src/youtube/bridge-client.js",
        "src/youtube/srt.js",
        "src/youtube/transcript.js",
        "src/youtube/watch.js",
        "src/youtube/panel.js",
        "src/youtube/playlist.js",
        "src/youtube/playlist-bar.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/youtube/bridge-protocol.js",
        "src/youtube/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "src/common/shared.js",
        "src/common/messages.js",
        "src/notebooklm/selectors.js",
        "src/notebooklm/automation.js",
        "src/notebooklm/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "import-video": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Import video đang xem vào Notebook đích"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "NotebookLM Importer",
    "default_popup": "popup.html"
  }
}
