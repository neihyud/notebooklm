{
  "manifest_version": 3,
  "name": "YouTube & Tài liệu → NotebookLM Importer",
  "version": "1.3.4",
  "description": "Đưa video YouTube và trang tài liệu vào NotebookLM. Video private và trang docs đều được trích nội dung ngay trên máy — thứ NotebookLM không tự đọc được.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "contextMenus",
    "notifications",
    "alarms",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://notebooklm.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "YouTube & Tài liệu → NotebookLM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "send-current-video": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Gửi video YouTube hiện tại sang NotebookLM"
    },
    "open-docs-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Mở bảng chọn link tài liệu"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/youtube/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/common/shared.js",
        "src/youtube/bridge-client.js",
        "src/youtube/transcript.js",
        "src/youtube/srt.js",
        "src/youtube/panel.js",
        "src/youtube/content.js"
      ],
      "css": [
        "src/youtube/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "src/common/shared.js",
        "src/notebooklm/selectors.js",
        "src/notebooklm/automation.js",
        "src/notebooklm/rpc.js",
        "src/notebooklm/content.js"
      ],
      "css": [
        "src/notebooklm/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "https://notebooklm.google.com/*",
        "*://*.google.com/search*",
        "*://mail.google.com/*",
        "*://*.slack.com/*"
      ],
      "js": [
        "src/common/shared.js",
        "src/docs/markdown.js",
        "src/docs/extract.js",
        "src/docs/sidebar.js",
        "src/docs/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/docs/overlay.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
